<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>warnings</Nullable>
    <Platforms>AnyCPU;x64</Platforms>
    <PublishAot>False</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.FlatBuffers" Version="25.2.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ProtoCache.Tests\ProtoCache.Tests.csproj" />
    <ProjectReference Include="..\ProtoCache\ProtoCache.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\ProtoCache.Tests\test.json" Link="test.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="GenerateFlatBufferFixture"
          Inputs="$(MSBuildProjectDirectory)/test.fbs;$(MSBuildProjectDirectory)/test-fb.json"
          Outputs="$(MSBuildProjectDirectory)/test.fb">
    <Exec Command="&quot;$(MSBuildProjectDirectory)/generate-fixtures.sh&quot;"
          WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>

  <Target Name="CopyFlatBufferFixture"
          AfterTargets="Build"
          Condition="Exists('$(MSBuildProjectDirectory)/test.fb')"
          DependsOnTargets="GenerateFlatBufferFixture">
    <Copy SourceFiles="$(MSBuildProjectDirectory)/test.fb"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
